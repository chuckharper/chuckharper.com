<!DOCTYPE html>
<html id="page_{{pageid}}">
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <meta name="viewport" content="width=device-width; initial-scale=1.0; maximum-scale=1.0;">

        <title>{{#if title}}{{title}}{{else}}Chuck Harper{{/if}}</title>
        <link rel='stylesheet' href='/css/screen.css' />
        <script src="https://kit.fontawesome.com/9b389c115e.js" crossorigin="anonymous"></script>
        <link href="/css/mobile.css" rel="stylesheet" type="text/css" media="screen and (max-width: 720px)">
        <script src="https://code.jquery.com/jquery-3.2.1.min.js"
                integrity="sha256-hwg4gsxgFZhOsEEamdOYGBf13FyQuiTwlAQgxVSNgt4="
                crossorigin="anonymous">
        </script>
        <link rel="stylesheet" type="text/css" href="/js/shadowbox-3.0.3/shadowbox.css">
        <script src="/js/shadowbox-3.0.3/shadowbox.js" type="text/javascript"></script>
        <script src="/js/inside.js" type="text/javascript"></script>

        <meta name="description" content="Chuck Harper offers consulting services for web software engineering and development, desktop support, digital video editing, and database development using the over twenty years experience gained while working for companies like 20th Century Fox, Pathway Capital Management, AEG Worldwide, AXS Ticketing and Shock Media Group." />
        <meta name="keywords" content="Chuck Harper, 92646, Full Stack, NodeJS, PHP, IT Consultant, Apple, Macintosh, web developer, web technologies, XHTML, XML, CSS, JavaScript, AJAX, RSS, Digital video editing, compositor, animator, Final Cut Pro, Motion, database developer, PostGresSQL, MySQL, MariaDB, Adobe Photoshop, Adobe Illustrator" />
        <meta name="title" content="{{#if title}}{{title}}{{else}}chuckharper.com{{/if}}" />
        <link rel="image_src" href="https://s3-us-west-1.amazonaws.com/chuckharpercdn/images/social.png" />

        <link rel="icon" type="image/png" href="https://s3-us-west-1.amazonaws.com/chuckharpercdn/images/favicon16.png" sizes="16x16">
        <link rel="icon" type="image/png" href="https://s3-us-west-1.amazonaws.com/chuckharpercdn/images/favicon32.png" sizes="32x32">
        <link rel="icon" type="image/png" href="https://s3-us-west-1.amazonaws.com/chuckharpercdn/images/favicon96.png" sizes="96x96">
        <link rel="apple-touch-icon" href="https://s3-us-west-1.amazonaws.com/chuckharpercdn/images/appletouch120.png">
        <link rel="apple-touch-icon" sizes="180x180" href="https://s3-us-west-1.amazonaws.com/chuckharpercdn/images/appletouch180.png">
        <link rel="apple-touch-icon" sizes="152x152" href="https://s3-us-west-1.amazonaws.com/chuckharpercdn/images/appletouch152.png">
        <link rel="apple-touch-icon" sizes="167x167" href="https://s3-us-west-1.amazonaws.com/chuckharpercdn/images/appletouch167.png">

        {{{block "head"}}}
    </head>
    <body id="body_{{pageid}}">
    <header>
        <h1><a href="/">{{title}}</a></h1>
    </header>
{{{body}}}
    {{#if sponsor_aside}}
    <aside id="home_sponsors">
        <h3><a href="/sponsors">Sponsors</a></h3>
        <ul class="sponsor_grid">
            {{#each sponsors}}
                <li>
                    <a href="{{link}}" rel="external">
                        <img src="{{image}}" alt="{{corp}}" class="{{ort}}" title="{{corp}} [{{ref}}]" id="aside_img_{{@index}}">
                    </a>
                </li>
            {{/each}}
        </ul>
        <div class="more"><a href="/sponsors">More Sponsors…</a></div>
    </aside>
    {{/if}}
    <footer>
        <div class="footer_social">
            <a href="https://www.facebook.com/chuckharper" rel="external" aria-hidden="true"><span class="fa-brands fa-square-facebook fa-2x">Facebook</span></a>
            <a href="https://github.com/chuckharper" rel="external" aria-hidden="true"><span class="fa-brands fa-square-github fa-2x">GitHub</span></a>
            <a href="https://www.printables.com/@grokmac_1642464" rel="external" aria-hidden="true"><span class="fa-solid fa-cube fa-2x">Printables</span></a>
            <a href="https://www.instagram.com/chuckharper/" rel="external" aria-hidden="true"><span class="fa-brands fa-square-instagram fa-2x">Instagram</span></a>
            <a href="https://www.linkedin.com/in/charleswharper/" rel="external" aria-hidden="true"><span class="fa-brands fa-square-linkedin fa-2x">LinkedIn</span></a>
            <a href="https://x.com/chuckharper" rel="external" aria-hidden="true fa-2x"><span class="fa-brands fa-square-x-twitter fa-2x">X (formerly Twitter)</span></a>
        </div>
        <div class="copyright">&copy;{{current_year}} Chuck Harper Consulting. All Rights Reserved.</div>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/bookmarks">Bookmarks</a></li>
            <li><a href="/sponsors">Sponsors</a></li>
        </ul>
    </footer>
    </body>
</html>
